# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/fieldcore

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public-facing app URL. Also controls the CORS allowed-origin list — the www variant
# is derived automatically (e.g. APP_URL=https://getfieldcore.com also allows https://www.getfieldcore.com).
APP_URL=https://your-app-url.com

# ── Web Dashboard ─────────────────────────────────────────────────────────────
# Backend origin used by the React/Vite web dashboard. Set in client/.env.
VITE_API_URL=https://your-api-url.com

# ── Mobile App (EAS Build) ────────────────────────────────────────────────────
# Backend origin baked into the Expo binary at build time. Must be set before
# running `eas build` — cannot be changed after the binary is distributed.
EXPO_PUBLIC_API_URL=https://your-api-url.com

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses.
# Used for: cancellation notifications, admin metrics gate, security alerts.
# First address in the list receives notification emails.
# All addresses in the list can access /api/billing/admin-metrics.
ADMIN_EMAILS=admin@getfieldcore.com,kevincaines925@gmail.com

# Email for low-level security alerts (brute force, API errors, etc.) — used by audit.js
ADMIN_ALERT_EMAIL=admin@getfieldcore.com

# ── Encryption (general) ──────────────────────────────────────────────────────
# 64-character hex string (32 bytes). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Server refuses to start if missing or all-zeros.
ENCRYPTION_KEY=replace-with-64-hex-chars-generated-above

# ── FieldCore Authority ───────────────────────────────────────────────────────
# Set AUTHORITY_ENABLED=true to activate the Authority domain.
# When true in production, all Authority config below becomes required —
# the server refuses to start if any required item is missing or invalid.
#
# Feature flag (default: false = disabled)
AUTHORITY_ENABLED=false

# Authority structured-data encryption key — MUST differ from ENCRYPTION_KEY above.
# Used to encrypt: authority_parties.display_name, authority_documents.original_filename
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-character hex string. Never use the all-zeros placeholder in production.
AUTHORITY_DATA_ENCRYPTION_KEY=replace-with-a-different-64-hex-chars-key

# Key version and ID — increment AUTHORITY_KEY_VERSION when rotating keys.
# The version and ID are stored in every ciphertext envelope for rotation tracking.
AUTHORITY_KEY_VERSION=1
AUTHORITY_KEY_ID=k1

# Authority document storage — a SEPARATE PRIVATE R2 bucket (NOT the legacy job-photo bucket).
# The bucket MUST be private with no public access or custom public domain configured.
# Objects are never served via public URL; only via authenticated server-side streaming.
# R2 encrypts objects at rest by default. All transfers use TLS.
#
# Get credentials from: Cloudflare dashboard → R2 → API tokens → Create API Token
# Create a new bucket named e.g. "fieldcore-authority-docs" (separate from the photo bucket).
R2_AUTHORITY_BUCKET=fieldcore-authority-docs
R2_AUTHORITY_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_AUTHORITY_ACCESS_KEY_ID=replace-with-r2-authority-access-key-id
R2_AUTHORITY_SECRET_ACCESS_KEY=replace-with-r2-authority-secret-access-key
R2_AUTHORITY_REGION=auto

# Maximum upload size for Authority documents (default: 50 MB, enforced by format registry)
# To override: adjust AUTHORITY_MAX_UPLOAD_BYTES in src/services/authorityFormatRegistry.js

# ── Stripe Platform ───────────────────────────────────────────────────────────
# Get from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Get from: dashboard.stripe.com/webhooks → your endpoint → Signing secret
# For local dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Get from: dashboard.stripe.com/products → each plan's Price ID (price_...)
# Create one product per plan in Stripe; copy the monthly Price ID for each.
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCALE=price_...

# Platform fee charged per transaction (default 1%)
PLATFORM_FEE_PERCENT=1

# ── Internal test tools (remove/set false before production) ──────────────────
# Enables POST /api/billing/test-checkout — owner-only Stripe Checkout trigger.
# Set to true only in test/staging environments. Never enable in production.
ENABLE_STRIPE_TEST_TOOLS=false
# Frontend override — set in Vercel env vars so the card shows without waiting for Railway deploy.
VITE_ENABLE_TEST_TOOLS=false

# ── Messaging Provider Switch ─────────────────────────────────────────────────
# Controls where outbound client messages (SMS/iMessage/RCS) are routed.
#
# PHASE 1 — Twilio SMS (current, active after A2P 10DLC approval):
#   MESSAGING_PROVIDER=twilio   (or leave unset — twilio is the default)
#   SMS_ENABLED=true            (flip this once Delaware C-Corp A2P is approved)
#
# PHASE 2 — Sendblue iMessage/RCS/SMS (after app store approval + $100/mo plan):
#   MESSAGING_PROVIDER=sendblue
#   SENDBLUE_API_KEY_ID=sb-api-key-...
#   SENDBLUE_API_SECRET_KEY=sb-api-secret-...
#
# Twilio stays for voice regardless of which provider is set.
MESSAGING_PROVIDER=twilio

# ── Twilio (Voice + SMS fallback) ─────────────────────────────────────────────
# Get from: console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
# Flip to true once A2P 10DLC registration is approved by carriers
SMS_ENABLED=false

# ── Sendblue (iMessage / RCS / SMS — activate after app store approval) ────────
# $100/month per phone line. Free sandbox is inbound-only (cannot send to clients).
# Sign up at: sendblue.com — get keys from dashboard → API Keys
# After signing up, set webhook URL in Sendblue dashboard to:
#   ${APP_URL}/api/webhooks/sendblue  (replace with your production APP_URL)
SENDBLUE_API_KEY_ID=sb-api-key-...
SENDBLUE_API_SECRET_KEY=sb-api-secret-...

# ── SMTP (email) ──────────────────────────────────────────────────────────────
# Omit to log emails to console in dev (no real emails sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password   # Gmail: use an App Password, not your login password
FROM_EMAIL=noreply@getfieldcore.com

# ── Google Business Profile (OAuth) ──────────────────────────────────────────
# Create OAuth credentials at: console.cloud.google.com → APIs & Services → Credentials
# Enable: "My Business Account Management API" and "My Business Business Information API"
# Redirect URI must be added as an Authorized redirect URI in the OAuth client.
# Token encryption: ENCRYPTION_KEY must be a 32-byte (64 hex char) secret.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://api.getfieldcore.com/api/google-reviews/callback
# Frontend origin — used to redirect back after OAuth (set to VITE app URL)
FRONTEND_URL=https://app.getfieldcore.com
# 32-byte hex key for AES-256-GCM encryption of stored OAuth tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── QuickBooks Online ─────────────────────────────────────────────────────────
# Create an app at: https://developer.intuit.com/app/developer/qbo/docs/get-started
# Add redirect URI in the app settings:
#   https://api.getfieldcore.com/api/integrations/accounting/quickbooks/callback
# Required scopes: com.intuit.quickbooks.accounting
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://api.getfieldcore.com/api/integrations/accounting/quickbooks/callback
# Environment: sandbox (for testing) or production
QUICKBOOKS_ENVIRONMENT=sandbox
# Optional: Intuit webhook verifier token (from app dashboard → Webhooks)
QUICKBOOKS_WEBHOOK_TOKEN=

# ── Google Maps ───────────────────────────────────────────────────────────────
# KEY ARCHITECTURE — two separate keys are required:
#
# 1. GOOGLE_MAPS_SERVER_KEY (backend only — Railway)
#    Used by: server-side geocoding (job creation, PATCH, Retry Geocoding)
#    Google Cloud config: Application restrictions: None | API restrictions: Geocoding API
#    NEVER set this in Vercel. NEVER expose this to the browser or Vite.
GOOGLE_MAPS_SERVER_KEY=
#
# 2. GOOGLE_MAPS_API_KEY (backend proxy — Railway)
#    Used by: /api/maps/autocomplete, /api/maps/geocode (proxy), /api/maps/route
#    Google Cloud config: Application restrictions: HTTP referrers → getfieldcore.com
#                         API restrictions: Maps JavaScript API, Places API, Directions API
GOOGLE_MAPS_API_KEY=
#
# 3. VITE_GOOGLE_MAPS_API_KEY (browser bundle — Vercel)
#    Same key value as GOOGLE_MAPS_API_KEY. Baked into client bundle at Vite build time.
#    MUST be set in Vercel env vars AND Vercel must be redeployed after changes.
#    For local dev: add to client/.env.local (gitignored), then run `npm run dev` in client/.
VITE_GOOGLE_MAPS_API_KEY=
#
# Optional: Cloud Map ID for production AdvancedMarker support.
# Get from: console.cloud.google.com → Maps → Map IDs → Create Map ID
# If unset, defaults to DEMO_MAP_ID (works but shows a dev watermark).
VITE_GOOGLE_MAPS_MAP_ID=

# ── AI Chat Widget ────────────────────────────────────────────────────────────
# Get from: console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── File Storage (Cloudflare R2 or AWS S3) ───────────────────────────────────
# Cloudflare R2 (recommended — no egress fees):
#   Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Create R2 bucket in Cloudflare dashboard → R2 → Create bucket
#   Create API token: R2 → Manage R2 API Tokens → Create Token (Object Read & Write)
#   Enable public access on bucket → copy the public URL
# AWS S3: omit R2_ENDPOINT, set R2_REGION to your bucket region (e.g. us-east-1)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=fieldcore-uploads
R2_PUBLIC_URL=https://your-bucket-public-url.com
R2_REGION=auto

# ── Beta Signup ───────────────────────────────────────────────────────────────
BETA_CAP=100
CONTACT_EMAIL=info@getfieldcore.com

# ── Seed (npm run db:init) ────────────────────────────────────────────────────
SEED_EMAIL=admin@yourdomain.com
SEED_PASSWORD=change-me
# Used to protect the database seed endpoint in development.
SEED_SECRET=
